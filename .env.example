# Copiez ce fichier en .env et renseignez vos valeurs.

# Serveur HTTP
PORT=8787
# URL du site vitrine statique (landing + pages légales) — mindlog.id.web.
# En dev : http://localhost:4321 (astro dev). En prod : https://mindlog.id ou votre domaine vitrine.
VITRINE_URL=https://mindlog.id
# Port du serveur admin mTLS (écoute 127.0.0.1 uniquement, certs dans certs/)
# Lancez d'abord : bash scripts/gen-admin-certs.sh
ADMIN_PORT=8788
# URL publique de base (utilisée dans les emails de récupération)
APP_URL=https://id.mindlog.today

# ----------------------------------------------------------------------------
# Base de données — PostgreSQL par défaut.
# ----------------------------------------------------------------------------
# Connexion Postgres (obligatoire en dev/prod). Les migrations Drizzle sont
# appliquées automatiquement au démarrage.
DATABASE_URL=postgres://mindlog:mindlog@localhost:5432/mindlog
# Taille max du pool de connexions pg (optionnel).
PG_POOL_MAX=10
# Pour les TESTS uniquement : DATABASE_DRIVER=pglite utilise un Postgres en
# mémoire (WASM), sans serveur. Ne pas utiliser en production.
# DATABASE_DRIVER=pglite

# URL de base utilisée par les scripts de test/vérification (Playwright).
TEST_BASE_URL=http://localhost:8799

# Cloudflare Turnstile (anti-robot à la création de page) — optionnel.
# Si TURNSTILE_SECRET_KEY est renseignée, la création vérifie le jeton côté
# serveur (sauf en localhost). La clé de site est publique (injectée au HTML).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----------------------------------------------------------------------------
# Facturation Stripe (abonnement Premium) — optionnelle.
# Si STRIPE_SECRET_KEY + STRIPE_PRICE_PREMIUM sont renseignées, les routes
# /api/billing/* s'activent (sinon 503). Le webhook /api/billing/webhook vérifie
# STRIPE_WEBHOOK_SECRET sur le corps brut. Prix = un Price récurrent (~1 €/mois).
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
# Page payante (marketplace) : Stripe Connect. Commission plateforme fixée à 30 %.
# (Pas de variable dédiée : la clé secrète Stripe ci-dessus suffit ; activez
#  Connect Express dans le dashboard Stripe.)
#
# DEV uniquement : autorise l'endpoint /api/dev/premium qui active le premium
# PAR UTILISATEUR (vraie ligne d'abonnement provider "dev" pour le compte courant).
# Permet d'avoir des comptes premium ET gratuits sur la même instance. isPremium()
# reste basé sur la base. Piloté par le toggle « Licence Premium » (onglet Options).
# Ignoré si NODE_ENV=production.
MINDLOG_DEV_PREMIUM=

# ----------------------------------------------------------------------------
# Google Play Billing (abonnement Premium via l'app Android) — optionnel.
# Si GOOGLE_PLAY_PACKAGE + GOOGLE_PLAY_SA_JSON sont renseignés, l'app peut
# valider ses achats côté serveur (/api/billing/google/verify). GOOGLE_RTDN_SECRET
# protège l'endpoint de notifications temps réel (Pub/Sub push ?secret=...).
# GOOGLE_PLAY_SA_JSON = contenu JSON du compte de service (rôle androidpublisher).
# ----------------------------------------------------------------------------
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_SA_JSON=
GOOGLE_RTDN_SECRET=

# ----------------------------------------------------------------------------
# Stockage tiers Premium (galeries/fichiers chiffrés hors plateforme).
# cf. docs/third-party-storage.md
# ----------------------------------------------------------------------------
# Chiffre AU REPOS les secrets de configuration stockage (clés S3, refresh-tokens
# OAuth). À DÉFINIR EN PRODUCTION (sinon retombe sur STRIPE_WEBHOOK_SECRET /
# VAPID_PRIVATE_KEY, puis une clé de dev avec avertissement). Valeur = chaîne
# longue et aléatoire ; sa rotation rend les configs stockées illisibles.
STORAGE_SECRET_KEY=
#
# OAuth « en un clic » — UNE app par fournisseur, enregistrée par l'OPÉRATEUR ;
# chaque créateur autorise ensuite SON propre compte. Laissez vide pour masquer
# le fournisseur (les créateurs gardent S3/R2/… avec leurs propres clés).
# URI de redirection à déclarer chez le fournisseur (remplacez par votre APP_URL) :
#   Google : ${APP_URL}/api/storage/oauth/gdrive/callback   (Drive API, scope drive.file)
#   Dropbox: ${APP_URL}/api/storage/oauth/dropbox/callback  (app « scoped », accès complet ou App folder)
#   Microsoft: ${APP_URL}/api/storage/oauth/onedrive/callback (scope Files.ReadWrite, offline_access)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Messagerie (SMTP) — optionnelle.
# Si renseignée, la récupération de compte ENVOIE le nouveau lien privé par
# email (au lieu de l'afficher à l'écran).
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Milo · mindlog id <milo@mindlog.today>"

# ----------------------------------------------------------------------------
# Clients OAuth « first-party » — apps mindlog officielles (ex. mindlog.todo).
# Au démarrage, l'IdP enregistre/maj un client CONFIDENTIEL (client_secret_post)
# avec un id et un secret FIXES, partagés via l'env entre l'IdP et l'app cliente.
# Ces valeurs doivent correspondre EXACTEMENT à MINDLOG_ID_CLIENT_ID /
# MINDLOG_ID_CLIENT_SECRET / MINDLOG_ID_REDIRECT_URI côté mindlog.todo.
#   - DEV  : redirect = https://todo.mindlog.localhost/api/v1/auth/mindlog-id/callback
#   - PROD : redirect = https://todo.mindlog.today/app/api/v1/auth/mindlog-id/callback
# Plusieurs redirect_uris possibles (séparées par des virgules). Générer le secret
# avec : openssl rand -hex 32. Laisser vide pour ne pas enregistrer de client.
# ----------------------------------------------------------------------------
MINDLOG_TODO_CLIENT_ID=
MINDLOG_TODO_CLIENT_SECRET=
MINDLOG_TODO_REDIRECT_URIS=
MINDLOG_TODO_CLIENT_NAME=mindlog.todo

# ----------------------------------------------------------------------------
# OIDC — Signature des id_token (OpenID Connect, pour Authentik).
# Générer une paire ES256 (P-256) :
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'P-256'});console.log(k.privateKey.export({type:'pkcs8',format:'pem'}).replace(/\n/g,'\\\\n'))"
# Collez la valeur PEM sur une ligne (les \n littéraux sont acceptés).
# Sans cette variable, les endpoints /oauth/jwks et id_token restent inactifs.
# ----------------------------------------------------------------------------
OIDC_PRIVATE_KEY_PEM=
