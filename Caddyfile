# Terminaison TLS pour id.mindlog.today.
# Le routeur SNI de l'hôte (edge-sni) passe le flux TLS de id.mindlog.today à ce
# Caddy (loopback 127.0.0.1:9543) ; Caddy obtient et renouvelle le certificat
# Let's Encrypt automatiquement via TLS-ALPN-01, puis proxifie vers l'app HTTP.
{
	admin off
	auto_https disable_redirects
}

id.mindlog.today {
	reverse_proxy app:8787
}
